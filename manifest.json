{
  "action": {
    "default_icon": {
      "16": "assets/icon/speaktube-robot-v2-16.png",
      "32": "assets/icon/speaktube-robot-v2-32.png",
      "48": "assets/icon/speaktube-robot-v2-48.png",
      "128": "assets/icon/speaktube-robot-v2-128.png"
    },
    "default_title": "SpeakTube"
  },
  "author": "Rica Soares",
  "background": {
    "service_worker": "sw.bundle.hdh2cnbfpdin.js"
  },
  "content_scripts": [
    {
      "js": [
        "diagnostics.js",
        "speech-improvements.js",
        "edge-voice-engine.js",
        "content.bundle.hdh2cnbfpdin.js",
        "webpage.bundle.hdh2cnbfpdin.js",
        "ga.bundle.hdh2cnbfpdin.js"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "left-panel.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "default_locale": "en",
  "description": "__MSG_extension_description__",
  "externally_connectable": {
    "matches": [
      "https://www.youtube.com/*"
    ]
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8766/*"
  ],
  "icons": {
    "16": "assets/icon/speaktube-robot-v2-16.png",
    "32": "assets/icon/speaktube-robot-v2-32.png",
    "48": "assets/icon/speaktube-robot-v2-48.png",
    "128": "assets/icon/speaktube-robot-v2-128.png",
    "512": "assets/icon/speaktube-robot-v2-512.png"
  },
  "key": "",
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "__MSG_extension_name__",
  "options_page": "don.html",
  "options_ui": {
    "open_in_tab": true,
    "page": "don.html"
  },
  "permissions": [
    "storage",
    "webRequest",
    "scripting",
    "nativeMessaging"
  ],
  "version": "1.4.0",
  "version_name": "1.4.0 - Native Mac voices and optional Edge TTS",
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.css",
        "popup.js",
        "popup-waveform.js",
        "speech-improvements.js",
        "edge-voice-engine.js",
        "assets/icon/speaktube-robot-v2-16.png",
        "assets/icon/speaktube-robot-v2-32.png",
        "assets/icon/speaktube-robot-v2-48.png",
        "assets/icon/speaktube-robot-v2-128.png",
        "assets/icon/speaktube-robot-v2-512.png"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}
